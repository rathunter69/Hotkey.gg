# Security headers (liability checklist, Security; pinned by app2/tests/security.test.js).
# Scripts: this origin plus the exact inline scripts the pages carry, by hash; no 'unsafe-inline', no
# eval, no inline handlers. After editing an inline script run: node app2/tests/headers-file.js --write
# Styles keep 'unsafe-inline' (the app sets style attributes in its templates); fonts come from Google
# Fonts; the only API is the Supabase project (REST, Auth, functions over https, Realtime over wss).
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-85IImuyKShQ5F+hLjZk398RjyDHLk8R3zmwnlxECWj4=' 'sha256-KF/irCFOtYOUTRyKWY7RhWY2XrqPZLhrsvOTo/ZlMy8=' 'sha256-RY50ZcxOUXfnHxX60N9QKTdHcquuc5BQQeJ3iESh/98=' 'sha256-iWwtDUwlOQlUSAolLAg3r0zXLifWTgxp0J8IBuHOsPI=' 'sha256-jvnX99rT7Plb9MdXKyGWbFh3VO0//Z6QOtoXn3ofjjk='; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://wepejasrnskvftgnnecr.supabase.co wss://wepejasrnskvftgnnecr.supabase.co; worker-src 'none'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
/*.html
  Cache-Control: no-cache
/health.json
  Cache-Control: no-store
/
  Cache-Control: no-cache
/lessons/
  Cache-Control: no-cache
/shortcuts/
  Cache-Control: no-cache
/*.js
  Cache-Control: public, max-age=0, must-revalidate
/*.css
  Cache-Control: public, max-age=0, must-revalidate
# Phase E checkout (docs/phases/E-checkout.md): the `payments` flag is on only for the preview
# deployments, so only they let Stripe in: Stripe.js and its iframes from *.stripe.com, and Link (the
# merchant of record) from *.link.com, in script, frame and connect; payment for Apple Pay in the frame.
# The "!" lines drop the site-wide header first, so the two policies are never both enforced.
# hotkey.gg keeps the strict policy above until Wolf says go; then these lines move to /*.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
  ! Content-Security-Policy
  ! Permissions-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-85IImuyKShQ5F+hLjZk398RjyDHLk8R3zmwnlxECWj4=' 'sha256-KF/irCFOtYOUTRyKWY7RhWY2XrqPZLhrsvOTo/ZlMy8=' 'sha256-RY50ZcxOUXfnHxX60N9QKTdHcquuc5BQQeJ3iESh/98=' 'sha256-iWwtDUwlOQlUSAolLAg3r0zXLifWTgxp0J8IBuHOsPI=' 'sha256-jvnX99rT7Plb9MdXKyGWbFh3VO0//Z6QOtoXn3ofjjk=' https://*.stripe.com https://*.link.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.stripe.com https://*.link.com; connect-src 'self' https://wepejasrnskvftgnnecr.supabase.co wss://wepejasrnskvftgnnecr.supabase.co https://*.stripe.com https://*.link.com; frame-src https://*.stripe.com https://*.link.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(self "https://js.stripe.com" "https://*.stripe.com" "https://*.link.com"), usb=()
